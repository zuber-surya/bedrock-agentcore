{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3List",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::campusassist-kb-zubersurya-771495376060"],
      "Condition": {"StringEquals": {"aws:ResourceAccount": ["771495376060"]}}
    },
    {
      "Sid": "S3Get",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::campusassist-kb-zubersurya-771495376060/*"],
      "Condition": {"StringEquals": {"aws:ResourceAccount": ["771495376060"]}}
    },
    {
      "Sid": "BedrockInvoke",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": ["arn:aws:bedrock:us-east-1::foundation-model/*"]
    }
  ]
}